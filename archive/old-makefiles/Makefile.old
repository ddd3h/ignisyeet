# IgnisYeet 6DOF Rocket Simulation Makefile
# Task 3: Complete Data Structure Implementation

CXX = g++
CXXFLAGS = -Wall -std=c++17 -Iinclude -O2
LDFLAGS = -lm

# Main executable sources (keeping legacy for now)
MAIN_SRCS = src/main.cpp src/rocket.cpp src/parameter.cpp src/output.cpp
MAIN_OBJS = $(MAIN_SRCS:.cpp=.o)
MAIN_TARGET = ignisyeet

# New architecture sources
PHYSICS_SRCS = src/physics/vector3d.cpp src/physics/state.cpp
SIMULATION_SRCS = src/simulation/engine.cpp src/simulation/integrator.cpp
ROCKET_SRCS = src/rocket/vehicle.cpp
ENVIRONMENT_SRCS = src/environment/atmosphere.cpp  
OUTPUT_SRCS = src/output/manager.cpp

# All new implementation sources
NEW_IMPL_SRCS = $(PHYSICS_SRCS) $(SIMULATION_SRCS) $(ROCKET_SRCS) $(ENVIRONMENT_SRCS) $(OUTPUT_SRCS)
NEW_IMPL_OBJS = $(NEW_IMPL_SRCS:.cpp=.o)

# New architecture main application
MAIN_V3_SRCS = src/main_v3.cpp src/parameter.cpp $(NEW_IMPL_SRCS)
MAIN_V3_OBJS = $(MAIN_V3_SRCS:.cpp=.o)
MAIN_V3_TARGET = ignisyeet_v3

# Architecture test
ARCH_TEST_SRCS = test_architecture.cpp $(NEW_IMPL_SRCS)
ARCH_TEST_OBJS = $(ARCH_TEST_SRCS:.cpp=.o)
ARCH_TEST_TARGET = test_architecture

# Full implementation test
FULL_TEST_SRCS = test_full_implementation.cpp src/parameter.cpp $(NEW_IMPL_SRCS)
FULL_TEST_OBJS = $(FULL_TEST_SRCS:.cpp=.o)
FULL_TEST_TARGET = test_full_implementation

# Gravity integration test
GRAVITY_INTEGRATION_TEST_SRCS = test_gravity_integration.cpp src/parameter.cpp $(NEW_IMPL_SRCS)
GRAVITY_INTEGRATION_TEST_OBJS = $(GRAVITY_INTEGRATION_TEST_SRCS:.cpp=.o)
GRAVITY_INTEGRATION_TEST_TARGET = test_gravity_integration

# Gravity model test
GRAVITY_TEST_SRCS = test_gravity.cpp src/physics/vector3d.cpp
GRAVITY_TEST_OBJS = $(GRAVITY_TEST_SRCS:.cpp=.o)
GRAVITY_TEST_TARGET = test_gravity

# Simple physics test
SIMPLE_TEST_SRCS = test_simple.cpp $(PHYSICS_SRCS)
SIMPLE_TEST_OBJS = $(SIMPLE_TEST_SRCS:.cpp=.o)
SIMPLE_TEST_TARGET = test_simple

# Simple gravity integration test
GRAVITY_SIMPLE_TEST_SRCS = test_gravity_simple.cpp src/physics/vector3d.cpp
GRAVITY_SIMPLE_TEST_OBJS = $(GRAVITY_SIMPLE_TEST_SRCS:.cpp=.o)
GRAVITY_SIMPLE_TEST_TARGET = test_gravity_simple

# Atmosphere model test
ATMOSPHERE_TEST_SRCS = test_atmosphere.cpp src/physics/vector3d.cpp
ATMOSPHERE_TEST_OBJS = $(ATMOSPHERE_TEST_SRCS:.cpp=.o)
ATMOSPHERE_TEST_TARGET = test_atmosphere

# Simple atmosphere integration test
ATMOSPHERE_SIMPLE_TEST_SRCS = test_atmosphere_simple.cpp src/physics/vector3d.cpp
ATMOSPHERE_SIMPLE_TEST_OBJS = $(ATMOSPHERE_SIMPLE_TEST_SRCS:.cpp=.o)
ATMOSPHERE_SIMPLE_TEST_TARGET = test_atmosphere_simple

# Main executable (legacy)
$(MAIN_TARGET): $(MAIN_OBJS)
	$(CXX) $(MAIN_OBJS) -o $(MAIN_TARGET) $(LDFLAGS)

# New architecture main executable
$(MAIN_V3_TARGET): $(MAIN_V3_OBJS)
	$(CXX) $(MAIN_V3_OBJS) -o $(MAIN_V3_TARGET) $(LDFLAGS)

# Architecture test executable
$(ARCH_TEST_TARGET): $(ARCH_TEST_OBJS)
	$(CXX) $(ARCH_TEST_OBJS) -o $(ARCH_TEST_TARGET) $(LDFLAGS)

# Full implementation test executable
$(FULL_TEST_TARGET): $(FULL_TEST_OBJS)
	$(CXX) $(FULL_TEST_OBJS) -o $(FULL_TEST_TARGET) $(LDFLAGS)

# Gravity integration test executable
$(GRAVITY_INTEGRATION_TEST_TARGET): $(GRAVITY_INTEGRATION_TEST_OBJS)
	$(CXX) $(GRAVITY_INTEGRATION_TEST_OBJS) -o $@ $(LDFLAGS)

# Gravity test executable
$(GRAVITY_TEST_TARGET): $(GRAVITY_TEST_OBJS)
	$(CXX) $(GRAVITY_TEST_OBJS) -o $@ $(LDFLAGS)

# Simple physics test executable
$(SIMPLE_TEST_TARGET): $(SIMPLE_TEST_OBJS)
	$(CXX) $(SIMPLE_TEST_OBJS) -o $@ $(LDFLAGS)

# Simple gravity test executable
$(GRAVITY_SIMPLE_TEST_TARGET): $(GRAVITY_SIMPLE_TEST_OBJS)
	$(CXX) $(GRAVITY_SIMPLE_TEST_OBJS) -o $@ $(LDFLAGS)

# Atmosphere test executable
$(ATMOSPHERE_TEST_TARGET): $(ATMOSPHERE_TEST_OBJS)
	$(CXX) $(ATMOSPHERE_TEST_OBJS) -o $@ $(LDFLAGS)

# Simple atmosphere test executable
$(ATMOSPHERE_SIMPLE_TEST_TARGET): $(ATMOSPHERE_SIMPLE_TEST_OBJS)
	$(CXX) $(ATMOSPHERE_SIMPLE_TEST_OBJS) -o $@ $(LDFLAGS)

# Task 3 specific targets
test_minimal: test_minimal.cpp $(PHYSICS_SRCS) src/parameter.cpp src/rocket.cpp src/output.cpp
	$(CXX) $(CXXFLAGS) $^ -o test_minimal $(LDFLAGS)

ignisyeet_v3_simple: src/main_v3_simple.cpp $(PHYSICS_SRCS) src/parameter.cpp src/rocket.cpp src/output.cpp  
	$(CXX) $(CXXFLAGS) $^ -o ignisyeet_v3_simple $(LDFLAGS)

# Generic rule for object files
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Test targets
test-simple: $(SIMPLE_TEST_TARGET)
	./$(SIMPLE_TEST_TARGET)

test-gravity: $(GRAVITY_TEST_TARGET)
	./$(GRAVITY_TEST_TARGET)

test-arch: $(ARCH_TEST_TARGET)
	./$(ARCH_TEST_TARGET)

test-full: $(FULL_TEST_TARGET)

test-gravity-integration: $(GRAVITY_INTEGRATION_TEST_TARGET)
	./$(GRAVITY_INTEGRATION_TEST_TARGET)

test-gravity-simple: $(GRAVITY_SIMPLE_TEST_TARGET)
	./$(GRAVITY_SIMPLE_TEST_TARGET)

test-atmosphere: $(ATMOSPHERE_TEST_TARGET)
	./$(ATMOSPHERE_TEST_TARGET)

test-atmosphere-simple: $(ATMOSPHERE_SIMPLE_TEST_TARGET)
	./$(ATMOSPHERE_SIMPLE_TEST_TARGET)

# Run all tests
test-all: test-simple test-arch test-full test-gravity test-gravity-integration test-atmosphere

# Task 3 completion verification
task3-verify: test_minimal ignisyeet_v3_simple
	@echo "=== Task 3 Verification ==="
	@echo "Running minimal integration test..."
	./test_minimal
	@echo ""
	@echo "Running v3 application test..."
	./ignisyeet_v3_simple
	@echo ""
	@echo "✅ Task 3 Complete - All tests passed!"

# Task 4 verification: Complete gravity model implementation
task4-verify: test-gravity test-gravity-simple
	@echo "=== Task 4 Verification Complete ==="
	@echo "✓ Gravity model implementation tests passed"
	@echo "✓ Physical model verification completed"
	@echo "✓ Level 1 (Uniform gravity) implemented and tested"
	@echo "✓ Level 2 (Altitude-dependent gravity) implemented and tested"
	@echo "✓ Level 3 (Rotating Earth gravity) implemented and tested"
	@echo "✓ Gravity integration demonstration completed"
	@echo ""
	@echo "🚀 Task 4: Gravity Model Implementation - COMPLETE!"

# Task 5 verification: Complete atmosphere model implementation
task5-verify: test-atmosphere test-atmosphere-simple
	@echo "=== Task 5 Verification Complete ==="
	@echo "✓ Atmosphere model implementation tests passed"
	@echo "✓ Physical model verification completed"
	@echo "✓ Level 1 (Simple atmosphere) implemented and tested"
	@echo "✓ Level 2 (ISA Standard atmosphere) implemented and tested"
	@echo "✓ Level 3 (Dynamic atmosphere) implemented and tested"
	@echo "✓ Atmosphere integration demonstration completed"
	@echo ""
	@echo "🌍 Task 5: Atmosphere Model Implementation - COMPLETE!"

# Clean targets
clean:
	rm -f $(MAIN_OBJS) $(MAIN_V3_OBJS) $(ARCH_TEST_OBJS) $(FULL_TEST_OBJS) $(SIMPLE_TEST_OBJS) $(GRAVITY_TEST_OBJS) $(GRAVITY_INTEGRATION_TEST_OBJS) $(ATMOSPHERE_TEST_OBJS) $(ATMOSPHERE_SIMPLE_TEST_OBJS)
	rm -f $(MAIN_TARGET) $(MAIN_V3_TARGET) $(ARCH_TEST_TARGET) $(FULL_TEST_TARGET) $(SIMPLE_TEST_TARGET) $(GRAVITY_TEST_TARGET) $(GRAVITY_INTEGRATION_TEST_TARGET) $(ATMOSPHERE_TEST_TARGET) $(ATMOSPHERE_SIMPLE_TEST_TARGET)
	rm -f test_minimal ignisyeet_v3_simple

clean-obj:
	rm -f $(MAIN_OBJS) $(MAIN_V3_OBJS) $(ARCH_TEST_OBJS) $(FULL_TEST_OBJS) $(SIMPLE_TEST_OBJS) $(GRAVITY_TEST_OBJS) $(GRAVITY_INTEGRATION_TEST_OBJS)

# Help target
help:
	@echo "Available targets:"
	@echo "  all          - Build legacy main executable (ignisyeet)"
	@echo "  v3           - Build new architecture main executable (ignisyeet_v3)"
	@echo "  test-simple  - Build and run simple physics tests"
	@echo "  test-arch    - Build and run architecture tests"
	@echo "  test-full    - Build and run full implementation tests"
	@echo "  test-all     - Run all test suites"
	@echo "  task3-verify - Verify Task 3 completion with all tests"
	@echo "  clean        - Remove all build artifacts"
	@echo "  clean-obj    - Remove only object files"
	@echo "  help         - Show this help message"

.PHONY: all v3 test-arch test-full test-simple test-all task3-verify clean clean-obj help
